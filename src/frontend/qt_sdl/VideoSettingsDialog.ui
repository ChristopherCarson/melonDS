   <item row="1" column="1">
    <widget class="QGroupBox" name="groupBox_3">
     <property name="title">
      <string>OpenGL renderer</string>
     </property>
     <layout class="QGridLayout" name="gridLayout_4">
      <item row="0" column="0">
       <widget class="QLabel" name="label_3">
        <property name="text">
         <string>Internal resolution:</string>
        </property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QCheckBox" name="cbBetterPolygons">
        <property name="whatsThis">
         <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Enabling this may help reduce distortion on quads and more complex polygons, but may also reduce performance.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
        </property>
        <property name="text">
         <string>Improved polygon splitting</string>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QComboBox" name="cbxGLResolution">
        <property name="whatsThis">
         <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;The resolution at which the 3D graphics will be rendered. Higher resolutions improve graphics quality when the main window is enlarged, but may also cause glitches.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
        </property>
       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QCheckBox" name="cbxComputeHiResCoords">
        <property name="text">
         <string>Use high resolution coordinates</string>
        </property>
       </widget>
      </item>
      <item row="4" column="0">
       <widget class="QCheckBox" name="cbStereo">
        <property name="toolTip">
         <string>Render separate left and right 3D views of the bottom screen.</string>
        </property>
        <property name="text">
         <string>Stereoscopic bottom screen</string>
        </property>
       </widget>
      </item>
      <item row="6" column="0">
       <widget class="QCheckBox" name="cbStereoHalfSBS">
        <property name="toolTip">
         <string>Squeeze each eye horizontally for displays that expand half side-by-side 3D.</string>
        </property>
        <property name="text">
         <string>Half side-by-side (Half SBS)</string>
        </property>
       </widget>
      </item>
      <item row="7" column="0">
       <layout class="QHBoxLayout" name="stereoSeparationLayout">
        <item>
         <widget class="QLabel" name="labelStereoSeparation">
          <property name="text">
           <string>Stereo separation:</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QSpinBox" name="sbStereoSeparation">
          <property name="minimum">
           <number>1</number>
          </property>
          <property name="maximum">
           <number>64</number>
          </property>
          <property name="value">
           <number>16</number>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item row="15" column="0">
       <layout class="QHBoxLayout" name="upscaleFilterLayout">
        <item>
         <widget class="QLabel" name="labelUpscaleFilter">
          <property name="text">
           <string>Upscaling filter:</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QComboBox" name="cbxUpscaleFilter">
          <property name="toolTip">
           <string>Smooth the displayed image using a pixel-art upscaling filter (HQ4x or xBRZ).</string>
          </property>
          <item>
           <property name="text">
            <string>Off</string>
           </property>
          </item>
          <item>
           <property name="text">
            <string>HQ4x</string>
           </property>
          </item>
          <item>
           <property name="text">
            <string>xBRZ</string>
           </property>
          </item>
         </widget>
        </item>
       </layout>
      </item>
      <item row="16" column="0">
       <widget class="QCheckBox" name="cbHQ4x2DOnly">
        <property name="toolTip">
         <string>Apply the upscaling filter only to 2D graphics (backgrounds, sprites, text) and keep 3D models sharp.</string>
        </property>
        <property name="text">
         <string>Upscaling filter: 2D graphics only</string>
        </property>
       </widget>
      </item>
      <item row="5" column="0">
       <widget class="QCheckBox" name="cbStereoTop">
        <property name="toolTip">
         <string>Show the top screen as a side-by-side pair. 2D content remains flat.</string>
        </property>
        <property name="text">
         <string>Stereoscopic top screen</string>
        </property>
       </widget>
      </item>
      <item row="8" column="0">
       <widget class="QCheckBox" name="cbStereoAdaptive">
        <property name="toolTip">
         <string>Automatically reduce stereo separation when the scene has large depth differences.</string>
        </property>
        <property name="text">
         <string>Adaptive stereo strength</string>
        </property>
       </widget>
      </item>
      <item row="9" column="0">
       <layout class="QHBoxLayout" name="stereoAdaptiveTargetLayout">
        <item>
         <widget class="QLabel" name="labelStereoAdaptiveTarget">
          <property name="text">
           <string>Depth target:</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QSpinBox" name="sbStereoAdaptiveTarget">
          <property name="toolTip">
           <string>Target eye disparity in native DS pixels. Lower values reduce stereo strength more aggressively. This is an estimate, not a strict limit.</string>
          </property>
          <property name="minimum">
           <number>1</number>
          </property>
          <property name="maximum">
           <number>128</number>
          </property>
          <property name="value">
           <number>24</number>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item row="10" column="0">
       <widget class="QCheckBox" name="cbStereoKeep2DInFront">
        <property name="toolTip">
         <string>Push the 3D scene back when it comes close to the camera (for example, zoomed-in dialogue) so that flat 2D elements like text boxes stay in front of it.</string>
        </property>
        <property name="text">
         <string>Keep 2D in front of 3D</string>
        </property>
       </widget>
      </item>
      <item row="11" column="0">
       <layout class="QHBoxLayout" name="stereoEdgeCropLayout">
        <item>
         <widget class="QLabel" name="labelStereoEdgeCrop">
          <property name="text">
           <string>Stereo edge crop:</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QSpinBox" name="sbStereoEdgeCrop">
          <property name="toolTip">
           <string>Black out this many native DS pixel columns on both side edges of each eye view. When automatic cropping is enabled, this is the minimum crop.</string>
          </property>
          <property name="minimum">
           <number>0</number>
          </property>
          <property name="maximum">
           <number>64</number>
          </property>
          <property name="value">
           <number>0</number>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item row="12" column="0">
       <widget class="QCheckBox" name="cbStereoAutoCrop">
        <property name="toolTip">
         <string>Estimate the stereo edge crop from the scene. The crop changes only after a new width persists for the settle time below; the manual crop remains the minimum.</string>
        </property>
        <property name="text">
         <string>Automatic stereo edge crop</string>
        </property>
       </widget>
      </item>
      <item row="13" column="0">
       <layout class="QHBoxLayout" name="stereoAutoCropSettleLayout">
        <item>
         <widget class="QLabel" name="labelStereoAutoCropSettle">
          <property name="text">
           <string>Auto crop settle frames:</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QSpinBox" name="sbStereoAutoCropSettle">
          <property name="toolTip">
           <string>Number of consecutive frames (60 per second) that must all call for a wider or narrower crop before the automatic crop changes. Higher values are steadier but slower to react.</string>
          </property>
          <property name="minimum">
           <number>1</number>
          </property>
          <property name="maximum">
           <number>600</number>
          </property>
          <property name="value">
           <number>30</number>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item row="14" column="0">
       <widget class="QCheckBox" name="cbStereoInset2D">
        <property name="toolTip">
         <string>Squeeze 2D graphics between the stereo crop bars. Touch input follows the inset 2D image; 3D-based touch targets may no longer align.</string>
        </property>
        <property name="text">
         <string>Fit 2D graphics inside stereo crop</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item row="0" column="1">
    <widget class="QGroupBox" name="groupBox_2">
     <property name="title">
      <string>Software renderer</string>
     </property>
     <layout class="QGridLayout" name="gridLayout_3">
      <item row="0" column="0">
       <widget class="QCheckBox" name="cbSoftwareThreaded">
        <property name="whatsThis">
         <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Run the software renderer on a separate thread. Yields better performance on multi-core CPUs.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
        </property>
        <property name="text">
         <string>Use separate thread</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
